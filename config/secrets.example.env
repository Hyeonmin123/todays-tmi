# 로컬 테스트용 템플릿. 실제 값을 채워 `config/secrets.env` 로 복사해 쓰세요.
# `config/secrets.env` 는 .gitignore 에 있어 커밋되지 않습니다.
# GitHub Actions 에서는 이 값들을 저장소 Settings > Secrets and variables > Actions 에 등록합니다.

# Instagram 비즈니스 계정 ID (토큰 생성 화면에 표시된 숫자, 17841... 로 시작)
IG_USER_ID=

# Instagram 사용자 액세스 토큰 (IGAA... 로 시작, 60일 유효 / refresh_token.py 로 갱신)
IG_ACCESS_TOKEN=

# GitHub Actions 가 자동 주입합니다. 로컬에서 이슈 알림 테스트할 때만 채우세요.
GITHUB_REPOSITORY=
GH_TOKEN=
